<!-- {% block content %}
{% autoescape off %}
 -->

<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;700&family=Oswald:wght@300;700&family=Roboto:wght@300;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" type="text/css" href="./dist/css/acc_active_email.css">

</head>

<main>

    <div class="wrapper">

        <table>

            <!-- @include './components/logo.kit' -->

            <tr>
                <div class="thanks">

                    <h1 class="section-heading">Witaj {{user.username}},
                    </h1>

                    <p class="thanks-text">Proszę kliknąć poniższy przycisk, aby skorzystać z naszych usług.</p>

                    <a href="http://{{domain}}{% url 'activate' uidb64=uid token=token %}" class="thanks-btn"
                        tabindex="0">
                        Potwierdź adres e-mail
                    </a>


                </div>
            </tr>

            <!-- @include './components/footer.kit' -->
        </table>
    </div>

</main>

</html>
